{
  "expo": {
    "name": "SwipeLog",
    "slug": "SwipeLog",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon-concept3.png",
    "scheme": "swipelog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.waage.swipelog",
      "icon": "./assets/images/icon-concept3.png",
      "associatedDomains": [
        "applinks:swipelog-b563d.firebaseapp.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071B2B",
        "foregroundImage": "./assets/images/android-icon-foreground-concept3.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.waage.SwipeLog",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "swipelog.app",
              "pathPrefix": "/u"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "swipelog-b563d.firebaseapp.com",
              "pathPrefix": "/__/auth/links"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-concept3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071B2B",
          "android": {
            "image": "./assets/images/splash-icon-concept3.png",
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SwipeLog to choose your profile picture and banner.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F9C80E",
          "defaultChannel": "watchlist-releases"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb2babcf-fcd5-4437-b57f-c5dda5ed66c0"
      }
    },
    "owner": "waage"
  }
}
