EXPO_PUBLIC_ENABLE_AUTH=false
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=false
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Firebase's default Hosting domain is authorized and handles mobile auth links.
EXPO_PUBLIC_AUTH_CONTINUE_URL=https://swipelog-b563d.firebaseapp.com/auth
# TMDB's client key. This EXPO_PUBLIC value is bundled into the mobile app by product decision.
EXPO_PUBLIC_TMDB_API_KEY=
EXPO_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
