EXPO_PUBLIC_ENABLE_AUTH=false
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=false
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional. Set this after deploying Firebase Functions auth email endpoints.
# Example: https://us-central1-swipelog-b563d.cloudfunctions.net
EXPO_PUBLIC_AUTH_EMAIL_FUNCTION_BASE_URL=
# Production and preview builds should use a backend proxy so the TMDB token is never bundled into the app.
EXPO_PUBLIC_TMDB_PROXY_URL=
# Optional for local development only. Do not set this in EAS production or preview environments.
EXPO_PUBLIC_TMDB_API_KEY=
EXPO_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
